{
  "name": "valoroulette-standalone",
  "version": "0.1.0",
  "description": "Roulette des agents Valorant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win nsis --publish never",
    "dist": "electron-builder --win nsis --publish never"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.valorant.roulette",
    "productName": "Valorant Roulette",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Valorant-Roulette-Setup-${version}.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "data/**/*"
    ],
    "asar": true,
    "forceCodeSigning": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Stevehunn",
        "repo": "Valoroulette-standalone"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
