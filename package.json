{
  "name": "valoroulette-standalone",
  "version": "1.0.0",
  "description": "Roulette des agents Valorant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . \"Valorant Roulette\" --platform=win32 --arch=x64 --out=dist --overwrite --ignore=node_modules --ignore=.git --ignore=dist --icon=\"./assets/icons/icon.ico\""
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.valorant.roulette",
    "productName": "Valorant Roulette",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Valorant Roulette.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "data/**/*"
    ],
    "asar": true,
    "forceCodeSigning": false
  }
}
